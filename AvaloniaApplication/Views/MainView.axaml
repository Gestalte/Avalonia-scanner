<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaApplication.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AvaloniaApplication.Views.MainView"
             x:DataType="vm:MainViewModel">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<Grid
		RowDefinitions="* auto *"
		ColumnDefinitions="* auto *">

		<Button
			Grid.Column="1"
			Grid.Row="1"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Padding="20"
			Command="{Binding ScanCommand}"
			Content="Scan"/>

		<ContentControl
			Grid.Column="0"
			Grid.Row="0"
			Grid.ColumnSpan="3"
			Grid.RowSpan="3"
			IsVisible="{Binding ShowScanner}"
			Content="{Binding Scanner}"/>

		<Panel
			IsVisible="{Binding ShowResult}"
			Grid.Column="0"
			Grid.Row="0"
			Grid.ColumnSpan="3"
			Grid.RowSpan="3"
			Background="Black"
			Opacity="90"/>
		<Panel
			IsVisible="{Binding ShowResult}"
			Background="White"
			Grid.Column="1"
			Grid.Row="1">
			<Border
				BorderBrush="LightGreen"
				BorderThickness="1">
				<Grid RowDefinitions="* * *">
					<TextBlock
						Grid.Row="0"
						Margin="20"
						FontSize="26"
						HorizontalAlignment="Center"
						Text="Scan Result:"/>
					<TextBlock
						Grid.Row="1"
						Margin="20"
						FontSize="20"
						HorizontalAlignment="Center"
						Text="{Binding ScanResult}"/>
					<Button
						Grid.Row="2"
						Margin="20"
						Foreground="DarkGreen"
						Background="LightGreen"
						BorderBrush="DarkGreen"
						HorizontalAlignment="Center"
						Command="{Binding ScanCommand}"
						Content="Scan Again"/>
				</Grid>
			</Border>
		</Panel>
	</Grid>
</UserControl>
