<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaApplication.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AvaloniaApplication.Views.MainView"
             x:DataType="vm:MainViewModel"
			 
			 xmlns:zxing="using:ZXing.Net.Maui.Controls"
			 xmlns:controls="using:Avalonia.Maui.Controls"
			 xmlns:mauiControls="using:Microsoft.Maui.Controls"
			 >
	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="* auto" ColumnDefinitions="auto *" Background="Gray">
		<controls:MauiControlHost
			IsVisible="{Binding !ShowResults}"
			Grid.ColumnSpan="2"
			Grid.Row="0"
			x:Name="cameraBarcodeReaderHost">
			<zxing:CameraBarcodeReaderView
				BarcodesDetected="BarcodesDetected"/>
		</controls:MauiControlHost>
		<Button
			Grid.Column="0"
			Grid.Row="1"
			Foreground="Yellow"
			Background="Tan"
			BorderBrush="Yellow"
			BorderThickness="2"
			Margin="10"
			Command="{Binding ToggleTorch}"
			Content="Torch"/>

		<Panel
			IsVisible="{Binding ShowResults}"
			Background="DarkGray"
			Opacity="65"
			Grid.Row="0"
			Grid.Column="0"
			Grid.RowSpan="2"
			Grid.ColumnSpan="2"/>
		<Grid
			IsVisible="{Binding ShowResults}"
			Grid.Row="0"
			Grid.Column="0"
			Grid.RowSpan="2"
			Grid.ColumnSpan="2"
			ColumnDefinitions="* auto *"
			RowDefinitions="* auto *">
			<Border
				Grid.Row="1"
				Grid.Column="1"
				BorderThickness="2"
				BorderBrush="Black">
			<Panel
				Background="White"
				Opacity="1">
				<StackPanel>
					<TextBlock
						Margin="10"
						FontSize="26"
						Text="Scan Result:"/>
					<TextBlock Margin="10" FontSize="18" Text="{Binding ScanResult}"/>
					<Button 
						Foreground="DarkGreen"
						Background="LightGreen"
						BorderBrush="Green"
						BorderThickness="2"
						Margin="10"
						VerticalAlignment="Center"
						HorizontalAlignment="Center" 
						Content="Scan Again"
						Command="{Binding ScanAgain}"/>
				</StackPanel>
			</Panel>
			</Border>
		</Grid>
	</Grid>
</UserControl>
